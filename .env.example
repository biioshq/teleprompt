# ---------------------------------------------------------------------------
# Teleprompt — environment
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Sign-in providers. Configure one, both, or neither - the sign-in page shows
# whichever are available and names the variables for the ones that are not.

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth app (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Auth.js refuses to trust the incoming Host header unless you tell it to.
# Vercel sets this implicitly; every other host (including `next start` on your
# own machine) needs it, or sign-in fails with UntrustedHost.
AUTH_TRUST_HOST="true"

# Database (Supabase Postgres) ---------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
#
# Use a POOLER URI, not the direct `db.<ref>.supabase.co` endpoint. The direct
# endpoint resolves to an IPv6 address only, and hosts without IPv6 egress -
# Vercel's functions among them - cannot reach it. The failure does not mention
# the database: it surfaces as an Auth.js "Configuration" error on sign-in.
#
# Note the username: postgres.<project-ref>, not plain postgres.
#   transaction pooler (port 6543) - best for serverless
#   session pooler     (port 5432) - behaves like a direct connection
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase Realtime (device-to-device signalling + relay) -------------------
# Both values are public by design. Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Public origin, used for canonical links, OG tags and the sitemap.
#
# On Vercel this is a system environment variable and is filled in for you, as
# long as "Enable access to System Environment Variables" is on in the project
# settings. It is always the production domain, even on preview deployments.
#
# Anywhere else, set it by hand to your own domain. It is a bare hostname with
# no scheme and no trailing slash. Leave it unset locally and the app resolves
# its own origin to http://localhost:<PORT>.
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL="teleprompt.biios.in"
